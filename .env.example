# =============================================================================
# FARM-TO-MARKET AI — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# INSTRUCTIONS FOR TEAM COLLABORATION:
# 1. Copy this file and rename it to '.env' in the project root:
#       cp .env.example .env
# 2. Fill in your confidential database credentials below.
# 3. DO NOT COMMIT '.env' TO GITHUB! (It is already listed in .gitignore).
# 4. To collaborate with friends in real-time, share the same remote PostgreSQL
#    or MySQL database credentials (e.g. from Supabase, Neon.tech, Render, AWS).
#    Both of you will see each other's recommendations, disease diagnoses,
#    and marketplace listings instantly!
# =============================================================================

# Application Settings
FLASK_ENV=development
DEBUG=True
PORT=5000
SECRET_KEY=change_me_to_a_random_secure_secret_key_in_production

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# --- OPTION 1: Local SQLite (Default, Zero Setup Required) ---
# When DATABASE_TYPE=sqlite, all data is saved in a local file on your machine.
DATABASE_TYPE=sqlite
SQLITE_DB_PATH=backend/data/farm_database.db
AUDIT_LOG_PATH=backend/data/farm_activity_log.jsonl

# --- OPTION 2: Shared Remote Cloud Database (For Team / Friend Collaboration) ---
# To collaborate with friends, create a free cloud database (e.g. Supabase, Neon.tech,
# ElephantSQL, Render, or Railway) and paste the connection URL or host credentials below:
#
# DATABASE_TYPE=postgres
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxx.supabase.co:5432/postgres
#
# Alternatively, configure individual connection parameters:
# DB_HOST=db.xxxx.supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=your_secure_password_here

# =============================================================================
# FILE UPLOAD & IMAGE STORAGE
# =============================================================================
# Uploaded crop photos and marketplace produce images are stored here
UPLOAD_FOLDER=backend/uploads
MAX_CONTENT_LENGTH=16777216  # Maximum upload size in bytes (16 MB)
