# =============================================================================
# FARM-TO-MARKET AI — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# INSTRUCTIONS FOR TEAM COLLABORATION:
# 1. Copy this file and rename it to '.env' in the project root:
#       cp .env.example .env
# 2. Fill in your confidential database credentials below.
# 3. DO NOT COMMIT '.env' TO GITHUB! (It is already listed in .gitignore).
# 4. To collaborate with team members in real-time, share the same remote MongoDB
#    Atlas connection string or local MongoDB instance.
#    All collaborators will see live crop recommendations, soil diagnoses,
#    sensor logs, and marketplace listings instantly on the UI!
# =============================================================================

# Application Settings
FLASK_ENV=development
DEBUG=True
PORT=5000
SECRET_KEY=farm_to_market_ai_secret_key_2026_andhra_pradesh

# =============================================================================
# DATABASE CONFIGURATION (MONGODB & HYBRID DOCUMENT STORE)
# =============================================================================
# Supported DATABASE_TYPE values:
#   - mongodb  (Recommended: Native BSON/JSON document storage for rich UI results)
#   - sqlite   (Local file fallback: zero-setup, persistent on disk)

DATABASE_TYPE=mongodb

# --- OPTION A: Remote MongoDB Atlas (Cloud NoSQL - Best for Teams & Live UI Sync) ---
# Create a free cluster at https://www.mongodb.com/cloud/atlas and paste URI below:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/farm_to_market_ai?retryWrites=true&w=majority

# --- OPTION B: Local MongoDB (Default local connection) ---
MONGODB_URI=mongodb://localhost:27017/farm_to_market_ai
MONGODB_DB_NAME=farm_to_market_ai

# Fallback local SQLite file path (used automatically if MongoDB is unreachable)
SQLITE_DB_PATH=backend/data/farm_database.db
AUDIT_LOG_PATH=backend/data/farm_activity_log.jsonl

# =============================================================================
# FILE UPLOAD & IMAGE STORAGE
# =============================================================================
# Uploaded crop photos and marketplace produce images are stored here
UPLOAD_FOLDER=backend/uploads
MAX_CONTENT_LENGTH=16777216  # Maximum upload size in bytes (16 MB)
