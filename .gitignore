# =============================================================================
# Git Ignore Rules for Farm-to-Market AI
# =============================================================================

# Confidential Environment & Database Secret Credentials
.env
.env.local
.env.*.local
*.env

# Local Database Files (Never commit local database binary files or locks)
*.db
*.db-journal
*.sqlite
*.sqlite3
backend/data/*.db
backend/data/farm_database.db
backend/data/*.jsonl

# User Uploaded Photos (Keeps empty directory structure via .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep
backend/uploads/diagnoses/*
!backend/uploads/diagnoses/.gitkeep
backend/uploads/marketplace/*
!backend/uploads/marketplace/.gitkeep

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Virtual Environments
venv/
.venv/
env/
ENV/

# IDE & Editor Configurations
.vscode/
.idea/
*.swp
*.swo

# Operating System Temporary Files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
